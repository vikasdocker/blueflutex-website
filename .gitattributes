# Normalise line endings on checkout. The repo stores LF; Windows checkouts
# would otherwise write CRLF, which Apache can choke on for .htaccess
# (a stray CR can produce a 500 rather than a clean error).
* text=auto eol=lf

# Binary assets must never be touched by line-ending normalisation --
# corrupting a PNG or woff2 is not a recoverable mistake.
*.png   binary
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary

# Source that benefits from keeping Windows CRLF (none today, but the
# escape hatch exists)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf